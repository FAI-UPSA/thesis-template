{
    "[typst]": {
        "editor.wordWrap": "bounded",
        "editor.wordWrapColumn": 100,
        "editor.wrappingIndent": "indent"
    },
    "ltex.language": "es-AR",
    "tinymist.fontPaths": [
        "${workspaceFolder}/assets/fonts"
    ],
    "tinymist.onPaste": "$root/assets/images",
    "tinymist.copyAndPaste": "enable",
    // Task gestiona las exportaciones finales, incluidos Bundle y PDF/SVG.
    "tinymist.exportPdf": "never",
    // "tinymist.previewFeature": "enable",
    // "tinymist.syntaxOnly": "auto",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.typ": "${capture}.pdf, ${capture}-*.pdf, ${capture}.svg",
        "*-PLAN.typ": "${capture}*.pdf",
    },
    "yaml.schemas": {
        "https://typst-community.github.io/json-schemas/docs/hayagriva.schema.json": [
            "**/*.{hay,haya,hayagriva}",
            "**/*.{hay,haya,hayagriva}.{yml,yaml}",
        ]
    }
}
